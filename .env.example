# Source checkout only. Desktop packages configure themselves.
# Use the in-app sign-in button. Set auto to reconnect on source startup.
QA_BACKEND=demo
PORT=8780
# Blank or race: race two available models. An exact ID explicitly selects a single fast model.
QA_FAST_MODEL=
# Blank: gpt-6-astra, independent of the fast race.
QA_SECONDARY_MODEL=
# Optional supported effort: blank uses lowest effort for speed, catalog default for depth.
QA_FAST_EFFORT=
QA_SECONDARY_EFFORT=
# Executables on PATH, or your own absolute paths. Do not commit local paths.
CODEX_BIN=codex
# Optional local speech recognition, both values required:
WHISPER_BIN=
WHISPER_MODEL=
