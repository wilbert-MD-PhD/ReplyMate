# Source checkout only. Desktop packages configure themselves.
# Use the in-app sign-in button. Set auto to reconnect on source startup.
QA_BACKEND=demo
PORT=8780
# Optional: exact model IDs from the app's model selector.
QA_FAST_MODEL=
QA_SECONDARY_MODEL=
# Optional: supported effort from your account's catalog; blank selects a supported low effort.
QA_FAST_EFFORT=
QA_SECONDARY_EFFORT=
# Executables on PATH, or your own absolute paths. Do not commit local paths.
CODEX_BIN=codex
# Optional local speech recognition, both values required:
WHISPER_BIN=
WHISPER_MODEL=
