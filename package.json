{
  "name": "replymate",
  "version": "2.5.3",
  "description": "ReplyMate（答伴）｜用自己的资料准备会议问答与英文面试。快速回答与独立深度回答，支持语音输入、文档导入、中文问题翻译和问答回看。",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "import": "node scripts/import-library.mjs",
    "check": "node scripts/check-release.mjs",
    "package": "node scripts/package-release.mjs",
    "desktop": "electron .",
    "desktop:prepare": "node scripts/build-components.mjs && node scripts/prepare-desktop.mjs",
    "desktop:build": "npm run desktop:prepare && electron-builder --publish never",
    "components:build": "node scripts/build-components.mjs",
    "whisper:build": "node scripts/build-whisper.mjs",
    "desktop:audit": "node scripts/audit-desktop.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wilbert-MD-PhD/ReplyMate.git"
  },
  "keywords": [
    "replymate",
    "presentation",
    "interview-preparation",
    "qa",
    "speech-recognition"
  ],
  "main": "desktop/main.cjs",
  "author": "wilbert",
  "dependencies": {},
  "devDependencies": {
    "@openai/codex": "0.161.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "fflate": "0.8.2"
  }
}
